# 로컬 서버에 필요한 환경 변수의 예시입니다. 실제 설정은 .env에 입력합니다.

# API 서버 주소와 실행 환경
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# 쓰기 요청을 허용할 프런트엔드 출처
APP_ORIGIN=http://localhost:5173
# MySQL 접속 정보
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saywhatyouknow
# AI 채점 설정. 기본은 로컬 Ollama로 채점합니다 (ollama pull qwen2.5:3b 필요).
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# 선택: AI_PROVIDER 줄을 지우면 Gemini API로 채점합니다 (만 18세 이상만 키 발급 가능).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 클라우드 DB(TiDB Cloud 등)는 암호화 연결을 켭니다.
DB_SSL=false
# 채점 AI를 Ollama로 쓰려면 아래를 설정합니다. OLLAMA_HOST가 비어 있으면 이 컴퓨터의 Ollama를 사용합니다.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=
OLLAMA_API_KEY=
