# 로컬 서버에 필요한 환경 변수의 예시입니다. 실제 설정은 .env에 입력합니다.

# API 서버 주소와 실행 환경
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# 쓰기 요청을 허용할 프런트엔드 출처
APP_ORIGIN=http://localhost:5173
# MySQL 접속 정보
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saywhatyouknow
# Gemini 채점 설정. AI_PROVIDER=ollama를 추가하면 로컬 Ollama로 채점하며 OLLAMA_MODEL로 모델을 지정합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

